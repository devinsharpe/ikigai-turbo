{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["*"]
    },
    "migrate": {
      "cache": false,
      "env": ["*"],
      "interactive": true
    },
    "generate-migrations": {
      "cache": false,
      "outputs": ["migrations/**"],
      "env": ["*"],
      "interactive": true
    }
  }
}
